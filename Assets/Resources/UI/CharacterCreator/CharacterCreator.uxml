<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="creator-root" class="creator-root" style="align-content: flex-start; margin-left: 122px; margin-right: 67px; ">
        <ui:Label name="title-label" text="Create a New Character" class="title-label" style="white-space: pre; -unity-font-style: bold; color: rgb(255, 255, 255); font-size: 70px; -unity-text-align: upper-left;"/>
        <ui:VisualElement class="progress-area">
            <ui:Label name="progress-label" text="Step 1 of 3" class="progress-label" style="-unity-font-style: bold; color: rgb(255, 255, 255); font-size: 20px;"/>
            <ui:VisualElement class="progress-track">
                <ui:VisualElement name="progress-fill" class="progress-fill"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="stage-1" class="stage">
            <ui:Label text="Basic Info" class="stage-title" style="-unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: upper-center; font-size: 40px;"/>
            <ui:Label text="The name is the internal id and is also used for the folder and JSON file." class="field-hint" style="color: rgb(255, 255, 255); font-size: 25px;"/>
            <ui:TextField name="name-field" label="Name" style="color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-outline-color: rgb(0, 0, 0); background-color: rgba(0, 0, 0, 0); background-size: 100% 100%; font-size: 30px;"/>
            <ui:TextField name="display-name-field" label="Display Name" style="color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 30px;"/>
            <ui:Toggle name="no-name-tag-field" label="No Name Tag" style="color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 30px;"/>
            <ui:Toggle name="not-visible-field" label="Not Visible" style="-unity-font-style: bold; color: rgb(255, 255, 255); font-size: 30px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="stage-2" class="stage" style="display: none;">
            <ui:Label text="Emotions &amp; Face" class="stage-title"/>
            <ui:DropdownField name="face-sprite-field" label="Face Sprite"/>
            <ui:Label name="emotions-title" text="Emotions" class="section-label"/>
            <ui:VisualElement name="emotions-list" class="emotions-list"/>
            <ui:Button name="add-emotion-button" text="+ Add Emotion" class="add-emotion-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="stage-3" class="stage" style="display: none;">
            <ui:Label text="World Settings" class="stage-title"/>
            <ui:Label text="How the character is scaled and placed in the courtroom." class="field-hint"/>
            <ui:Vector2Field name="size-field" label="Size"/>
            <ui:Vector2Field name="offset-field" label="Offset"/>
            <ui:FloatField name="face-height-field" label="Face Height"/>
        </ui:VisualElement>
        <ui:VisualElement class="nav-bar">
            <ui:Button name="back-button" text="Back" class="nav-button back-button" style="display: none;"/>
            <ui:Label name="status-label" text="" class="status-label"/>
            <ui:Button name="next-button" text="Next" class="nav-button next-button" style="font-size: 30px; -unity-font-style: bold;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
